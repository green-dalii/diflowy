---
type Props = {
  sectionTitle: string;
  description: string;
  // Heading element used for the section title. Pages that already render their
  // own <h1> (e.g. the workflow detail page) pass "p" so the document keeps a
  // single, meaningful <h1>.
  as?: "h2" | "p";
};

const { sectionTitle, description, as = "h2" } = Astro.props;
const sectionTitleClass =
  "text-5xl text-center sm:text-left break-keep shrink-0";
---

<div class="flex flex-col flex-wrap items-center gap-10 mb-20 sm:flex-row">
  {
    as === "p" ? (
      <p class={sectionTitleClass}>{sectionTitle}</p>
    ) : (
      <h2 class={sectionTitleClass}>{sectionTitle}</h2>
    )
  }
  <p class="w-auto text-center sm:text-left sm:w-[580px]">
    {description}
  </p>
</div>
